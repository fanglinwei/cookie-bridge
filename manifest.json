{
  "manifest_version": 3,
  "name": "Cookie Bridge · Cookie 管理",
  "description": "选取、收藏和跨站应用 Cookie，快速切换开发账号。数据仅在本机保存。",
  "version": "0.0.1",
  "minimum_chrome_version": "120",
  "permissions": ["cookies", "storage", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "assets/logo/cookie-bridge-16.png",
    "32": "assets/logo/cookie-bridge-32.png",
    "48": "assets/logo/cookie-bridge-48.png",
    "128": "assets/logo/cookie-bridge-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Cookie Bridge",
    "default_icon": {
      "16": "assets/logo/cookie-bridge-16.png",
      "32": "assets/logo/cookie-bridge-32.png",
      "48": "assets/logo/cookie-bridge-48.png"
    }
  },
  "options_ui": { "page": "index.html?view=manage", "open_in_tab": true },
  "background": { "service_worker": "src/background.ts", "type": "module" },
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
