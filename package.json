{
  "name": "cookie-bridge",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
