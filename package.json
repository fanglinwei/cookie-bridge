    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "license": "MIT",
  "description": "A local-first Chrome extension to select, save, and apply cookies across websites.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanglinwei/cookie-bridge.git"
